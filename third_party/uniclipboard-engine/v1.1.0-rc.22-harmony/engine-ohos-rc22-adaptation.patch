+fn network_settings(summary: &uc_engine::SettingsSummary) -> OhNetworkSettings {
+    OhNetworkSettings {
+        allow_relay_fallback: summary.network.allow_relay_fallback,
+        custom_relay_urls: summary.network.custom_relay_urls.clone(),
+    }
