new file mode 100644
index 0000000..97ba7f7
--- /dev/null
+++ b/crates/uc-infra/src/network/iroh/dns_resolver.rs
@@ -0,0 +1,126 @@
+//! Platform DNS integration for iroh.
+//!
+//! HarmonyOS exposes DNS through its libc resolver while the target is compiled
+//! with Linux/Unix cfgs. Hickory's generic Unix path reads resolv.conf and sends
+//! DNS packets itself; use the host resolver for address records on OHOS instead.
+
+use iroh::dns::DnsResolver;
+
+#[cfg(any(target_env = "ohos", test))]
+use {
+    iroh::dns::{BoxIter, DnsError, Resolver, TxtRecordData, DNS_TIMEOUT},
+    n0_error::StdResultExt,
+    std::{
+        future::Future,
+        net::{IpAddr, Ipv4Addr, Ipv6Addr},
+        pin::Pin,
+    },
+};
+
+#[cfg(any(target_env = "ohos", test))]
+type BoxFuture<T> = Pin<Box<dyn Future<Output = T> + Send + 'static>>;
+
+#[cfg(any(target_env = "ohos", test))]
+#[derive(Debug)]
+struct OhosSystemResolver {
+    txt_resolver: DnsResolver,
+}
+
+#[cfg(any(target_env = "ohos", test))]
+impl OhosSystemResolver {
+    fn new() -> Self {
+        Self {
+            txt_resolver: DnsResolver::new(),
+        }
+    }
+
+    fn lookup_addresses(host: String) -> BoxFuture<Result<Vec<IpAddr>, DnsError>> {
+        Box::pin(async move {
+            let addresses = tokio::net::lookup_host((host.as_str(), 0)).await.anyerr()?;
+            Ok(addresses.map(|address| address.ip()).collect())
+        })
+    }
+}
+
+#[cfg(any(target_env = "ohos", test))]
+impl Resolver for OhosSystemResolver {
+    fn lookup_ipv4(&self, host: String) -> BoxFuture<Result<BoxIter<Ipv4Addr>, DnsError>> {
+        Box::pin(async move {
+            let addresses = Self::lookup_addresses(host).await?;
+            let addresses = addresses
+                .into_iter()
+                .filter_map(|address| match address {
+                    IpAddr::V4(address) => Some(address),
+                    IpAddr::V6(_) => None,
+                })
+                .collect::<Vec<_>>();
+            Ok(Box::new(addresses.into_iter()) as BoxIter<Ipv4Addr>)
+        })
+    }
+
+    fn lookup_ipv6(&self, host: String) -> BoxFuture<Result<BoxIter<Ipv6Addr>, DnsError>> {
+        Box::pin(async move {
+            let addresses = Self::lookup_addresses(host).await?;
+            let addresses = addresses
+                .into_iter()
+                .filter_map(|address| match address {
+                    IpAddr::V6(address) => Some(address),
+                    IpAddr::V4(_) => None,
+                })
+                .collect::<Vec<_>>();
+            Ok(Box::new(addresses.into_iter()) as BoxIter<Ipv6Addr>)
+        })
+    }
+
+    fn lookup_txt(&self, host: String) -> BoxFuture<Result<BoxIter<TxtRecordData>, DnsError>> {
+        let resolver = self.txt_resolver.clone();
+        Box::pin(async move {
+            let records = resolver.lookup_txt(host, DNS_TIMEOUT).await?;
+            Ok(Box::new(records.collect::<Vec<_>>().into_iter()) as BoxIter<TxtRecordData>)
+        })
+    }
+
+    fn clear_cache(&self) {
+        self.txt_resolver.clear_cache();
+    }
+
+    fn reset(&self) -> Box<dyn Resolver> {
+        let txt_resolver = self.txt_resolver.clone();
+        txt_resolver.reset();
+        Box::new(Self { txt_resolver })
+    }
+}
+
+pub(crate) fn platform_dns_resolver() -> DnsResolver {
+    #[cfg(target_env = "ohos")]
+    {
+        DnsResolver::custom(OhosSystemResolver::new())
+    }
+
+    #[cfg(not(target_env = "ohos"))]
+    {
+        DnsResolver::new()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::OhosSystemResolver;
+    use iroh::dns::Resolver;
+    use std::net::Ipv4Addr;
+
+    #[tokio::test]
+    async fn system_resolver_resolves_loopback_via_host_name_service() {
+        let resolver = OhosSystemResolver::new();
+        let addresses = resolver
+            .lookup_ipv4("localhost".to_string())
+            .await
+            .expect("system resolver should resolve localhost")
+            .collect::<Vec<_>>();
+
+        assert!(
+            addresses.contains(&Ipv4Addr::LOCALHOST),
+            "expected 127.0.0.1 from the system resolver, got {addresses:?}"
+        );
+    }
+}
